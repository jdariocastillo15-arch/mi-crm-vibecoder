# ---------------------------------------------------------------------------
# Vibe CRM — variables de entorno
#
# En local NO hace falta copiar esto a mano: `npx convex dev` crea el .env.local
# con las dos primeras variables la primera vez que lo ejecutas.
#
# En Railway sí hay que configurarlas a mano. Ver README, sección "Publicar".
# ---------------------------------------------------------------------------

# URL pública del despliegue de Convex. La escribe `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=https://tu-proyecto.convex.cloud

# Nombre del despliegue de Convex. Solo lo usa el CLI en local.
CONVEX_DEPLOYMENT=dev:tu-proyecto

# Solo en Railway (producción): clave de despliegue de producción de Convex.
# Se genera en el panel de Convex → Settings → Deploy Keys.
# CONVEX_DEPLOY_KEY=
